# Copiar a .env (gitignored) para desarrollo local.
DEBUG=True
SECRET_KEY=local-dev-secret-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/restaurante
REDIS_URL=redis://localhost:6379/0

# Correo: por defecto imprime en consola (no requiere credenciales).
# Para Brevo (https://app.brevo.com/settings/keys/smtp), descomentar:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tu-email-de-brevo@ejemplo.com
# EMAIL_HOST_PASSWORD=tu-smtp-key-de-brevo
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Zennin Bistro <no-reply@tudominio.com>
